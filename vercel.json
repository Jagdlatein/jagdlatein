{
  "crons": [
    {
      "path": "/api/internal/trial-notifications",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/quiz",
      "destination": "/quiz-app/run",
      "permanent": true
    },
    {
      "source": "/quiz/",
      "destination": "/quiz-app/run",
      "permanent": true
    },
    {
      "source": "/quiz/:path*",
      "destination": "/quiz-app/run",
      "permanent": true
    }
  ]
}
